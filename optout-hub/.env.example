##############################################################################
# Configuration model — read this first
#
# There are TWO kinds of configuration, and they live in DIFFERENT places:
#
#  (1) ENVIRONMENT-AUTHORITATIVE  — everything in THIS file.
#      Secrets, database/infrastructure, the reverse-proxy/TLS posture,
#      single sign-on, the login throttle, and logging. These are read from
#      the environment (or a mounted `<NAME>_FILE`) at startup. The Settings
#      UI deliberately does NOT expose them — they are secrets, or they must
#      be known before the database is reachable, or they are security
#      controls we keep off the app-editable surface.
#
#  (2) UI-AUTHORITATIVE (operational policy) — managed in Admin -> Settings,
#      stored in the database. Things like consent posture, propagation scope,
#      review TTLs, retention windows, scheduler intervals, phone region, and
#      the webhook skew window. Change these IN THE UI; changes apply
#      immediately and are audited.
#      The env var for each of those ONLY SEEDS the initial default on a fresh
#      database — once the database has a value (i.e. after first boot, or once
#      you save it in the UI), the env var is IGNORED. Those seed-only vars are
#      listed at the very bottom, clearly marked, so nothing here silently
#      fights the UI.
#
# Rule of thumb: if you can change it under Admin -> Settings, change it THERE,
# not here. If it is in the top section of this file, the environment is the
# only place to set it.
##############################################################################


# =============================================================================
# (1) ENVIRONMENT-AUTHORITATIVE — set these here (or via <NAME>_FILE / secrets)
# =============================================================================

# --- Secrets -----------------------------------------------------------------
# Every secret below can instead be supplied from a FILE via a `<NAME>_FILE`
# variable pointing at a mounted secret — e.g.
# DATABASE_URL_FILE=/run/secrets/database_url. The file's contents are the
# value. This is the Docker/Kubernetes secret, Azure Key Vault CSI, and
# Vault-agent pattern; prefer it in production so secrets never sit in .env or
# the process environment. The file form takes precedence over the plain var.

# Connection string for PostgreSQL. The default matches docker-compose.yml.
# For Azure Database for PostgreSQL Flexible Server, use the connection string
# from the portal (require ssl: append ?sslmode=require). REQUIRED in production
# (or DATABASE_URL_FILE).
DATABASE_URL=postgres://hub:hub_dev_password@localhost:5432/optout_hub

# Encrypts stored sending-service credentials at rest (AES-256-GCM, key derived
# via scrypt). REQUIRED in production (or APP_SECRET_FILE), minimum 16 chars —
# the app refuses to boot in production without a strong value, so a forgotten
# key can't silently fall back to a public dev default. Generate one with e.g.
#   openssl rand -base64 48
# To ROTATE without downtime: set the new key as APP_SECRET and the current one
# as APP_SECRET_OLD, then run `npm run reencrypt` to re-encrypt stored
# credentials under the new key, then retire APP_SECRET_OLD.
# APP_SECRET=
# APP_SECRET_OLD=   # only set during a rotation (see npm run reencrypt)

# Bootstrap account passwords (used once, when `npm run seed` finds no users).
# REQUIRED when NODE_ENV=production — the seed refuses to create an account with
# a built-in default there. See RUNBOOK-key-and-credential-rotation.md.
# ADMIN_BOOTSTRAP_PASSWORD=
# OPERATOR_BOOTSTRAP_PASSWORD=
# APPROVER_BOOTSTRAP_PASSWORD=

# Optional outbound webhook for sync-lag alerts. If set, each alert is POSTed as
# JSON ({ text, alert }) — compatible with a Slack/Teams incoming webhook. Every
# alert is also written to the audit log regardless of this setting. This is a
# secret (the URL is a bearer capability) and may be supplied via
# ALERT_WEBHOOK_URL_FILE.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# GET /metrics exposes Prometheus text-format gauges. If METRICS_TOKEN is set,
# the endpoint requires `Authorization: Bearer <token>` (put the same token in
# the Prometheus scrape config). Leave unset only when /metrics is unreachable
# from outside a trusted network. Secret; may be supplied via METRICS_TOKEN_FILE.
# METRICS_TOKEN=

# Shared token authenticating the Twilio Event Streams sink at
# POST /api/webhooks/twilio-events/:systemId. Event Streams is an ADDITIVE way to
# receive inbound opt-outs (a Sink + a subscription to inbound-message events)
# that runs alongside a Messaging Service's own webhook — use it when that webhook
# is owned by a third-party app you can't repoint. Unlike messaging webhooks,
# Event Streams sinks aren't request-signed, so the route requires this token
# (constant-time compared); until it's set the route returns 503 and ingests
# nothing. Put it in the Sink URL as ?token=... (or send an x-events-token header).
# Generate one with e.g.  openssl rand -hex 32. Secret; may use TWILIO_EVENTS_TOKEN_FILE.
# TWILIO_EVENTS_TOKEN=

# --- Server / infrastructure -------------------------------------------------
# Port the HTTP server binds. Read at startup.
PORT=3000

# Behind a reverse proxy / TLS terminator, trust its forwarding headers so req.ip
# (audit log, login throttle) and req.protocol reflect the real client. Number =
# hops, or a value like "loopback" / "uniquelocal" / an IP. Leave unset when not
# behind a proxy. Security-sensitive: only trust a proxy you actually run.
# TRUST_PROXY=1

# Enforce HTTPS: redirect plaintext HTTP requests to https (308) and send HSTS.
# Defaults ON when NODE_ENV=production; set FORCE_HTTPS=1 to force it on (or =0
# to disable). The app is HTTP behind a TLS-terminating proxy, so this REQUIRES
# TRUST_PROXY (above) to be set — otherwise every request looks plaintext and the
# redirect loops. /healthz and /readyz are exempt (load balancers probe them over
# HTTP). Leave off for local http development.
# FORCE_HTTPS=1

# Public base URL of this hub (scheme + host, no trailing slash), as reachable
# from the internet. Inbound platform webhooks are signature-verified over the
# EXACT URL the platform calls, so behind a proxy/tunnel the hub must know its
# public URL to verify correctly. Also used to build the URL when auto-
# provisioning a platform's inbound webhook (Admin -> Services -> Provision
# inbound webhook, e.g. Twilio). Deployment topology, so it lives here (not the
# UI): on localhost the hub falls back to the request host, which the platform
# can't reach.
# WEBHOOK_PUBLIC_BASE=https://hub.example.edu

# Shared store for the consent-check per-key rate limiter, so one true limit is
# enforced across all instances (without it, each instance limits independently).
# Requires the optional `redis` package: `npm install redis`. Sessions are
# already shared via PostgreSQL, so nothing else is needed for multi-instance.
# REDIS_URL=redis://localhost:6379

# --- Authentication / SSO ----------------------------------------------------
# OIDC single sign-on (any compliant IdP: Entra ID, Okta, Keycloak, ...). The
# OIDC client is built at startup and role mapping assigns privileges, so this
# stays in the environment (not the UI). OIDC_CLIENT_SECRET is a secret (see the
# Secrets note above; supports OIDC_CLIENT_SECRET_FILE).
# For Entra ID: OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/sso/oidc/callback
# OIDC_PROVIDER_NAME=Example SSO
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAP={"sg-optout-approvers":"approver","sg-optout-operators":"operator"}
# SSO_JIT_ROLE=viewer

# Built-in mock IdP for testing the SSO flow without a real provider.
# Never enabled when NODE_ENV=production.
# AUTH_DEV_MOCK_SSO=1

# Per-IP login throttle (defense-in-depth over the per-account lockout). After
# MAX_FAILURES failed sign-ins from one address within WINDOW_MINUTES, that IP is
# blocked for BLOCK_MINUTES. Only failures count and a success resets, so normal
# users aren't affected. Set MAX_FAILURES=0 to disable. Behind a proxy, set
# TRUST_PROXY so the real client IP is used. Defaults: 10 / 15 / 15.
# This is a security control on the sign-in endpoint, so it is intentionally
# environment-only (not togglable from inside the authenticated app).
# LOGIN_THROTTLE_MAX_FAILURES=10
# LOGIN_THROTTLE_WINDOW_MINUTES=15
# LOGIN_THROTTLE_BLOCK_MINUTES=15

# --- Logging -----------------------------------------------------------------
# Structured logs: one JSON object per line (stdout for info/debug, stderr for
# warn/error), including a per-request access line with reqId, method, path,
# status, latency, actor, and ip. Any aggregator (Azure Monitor, Splunk, ELK)
# can parse it. LOG_LEVEL filters (debug|info|warn|error). LOG_FORMAT=pretty
# gives a terminal-friendly line for local dev instead of JSON. Read once at
# startup (the logger runs before the database is available), so these stay in
# the environment rather than the UI.
# LOG_LEVEL=info
# LOG_FORMAT=json


# =============================================================================
# (2) SEED-ONLY DEFAULTS for UI-managed settings  (Admin -> Settings)
# =============================================================================
# Each var below ONLY seeds the initial default on a FRESH database. After first
# boot the database is authoritative and these are IGNORED — change the value
# under Admin -> Settings, not here. They are listed for completeness / for
# pre-seeding an initial deployment. (Settings that have no env seed at all —
# opt-out propagation scope, review trigger, review TTL, TTL-reset-on-coalesce,
# pre-select same-channel — are UI-only and intentionally absent here.)

# Safety
# ENABLE_OUTBOUND_WRITES=true             # true = production (push opt-outs/opt-ins to platforms).
#                                         # false = TEST MODE: ingest + cascade internally, but never
#                                         # push a write to any sending service (logs what it would write).

# Consent decision
# CONSENT_CHECK_MODE=blocklist            # blocklist | allowlist (unknown-identity posture)
# CONSENT_CHECK_RATE_LIMIT_PER_SEC=60     # hub-wide default per-key limit; 0 disables

# Opt-in reviews
# INITIATOR_CANNOT_APPROVE=1              # separation of duties (initiator can't approve)

# Retention & alerts
# SYNC_LAG_ALERT_HOURS=24                 # sync-lag alert threshold (hours)
# CONSENT_CHECK_RETAIN_SUPPRESS_DAYS=1461 # ~4 yr; statutory suppress-decision evidence
# CONSENT_CHECK_RETAIN_OTHER_DAYS=90      # allow/error audit retention

# Scheduled jobs (0 = disabled; single-process — enable on ONE instance only, or
# use external cron hitting /api/{reconcile,consent-checks/prune,poll,alerts/scan}).
# RECONCILE_INTERVAL_MINUTES=15
# PRUNE_INTERVAL_HOURS=24
# POLL_INTERVAL_MINUTES=5                 # pulls opt-outs from no-webhook platforms (e.g. Constant Contact)
# ALERT_SCAN_INTERVAL_MINUTES=30

# Normalization
# DEFAULT_PHONE_REGION=US                 # ISO-3166 alpha-2 for numbers without a country code

# Webhooks
# WEBHOOK_MAX_SKEW_SECONDS=300            # reject webhooks whose signed timestamp is older/newer; 0 disables
