# Copy to `.env` (docker compose reads it automatically). Do NOT commit `.env`.

# ---- Required ---------------------------------------------------------------

# The app refuses to boot in production without a strong APP_SECRET (min 16 chars;
# it encrypts stored platform credentials). Generate one:  openssl rand -hex 32
APP_SECRET=

# Password for the bundled PostgreSQL.
POSTGRES_PASSWORD=

# ---- Optional ---------------------------------------------------------------

# POSTGRES_USER=hub
# POSTGRES_DB=optout_hub

# Only set during a key rotation (then run `npm run reencrypt` inside the app
# container), and retire it afterward.
# APP_SECRET_OLD=

# Bearer token required to read /metrics. /metrics is already blocked at nginx;
# set this only if you scrape it in-network and want auth there too.
# METRICS_TOKEN=

# The public base URL (scheme + host) used to verify inbound webhook signatures.
# Set this to your real hostname if you receive signed platform webhooks.
# WEBHOOK_PUBLIC_BASE=https://your-host.example.edu

# OIDC / SSO (any compliant IdP). Leave blank to use local accounts only.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-host.example.edu/auth/sso/oidc/callback
